{
  "name": "@industrieh/starmap-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter '@industrieh/example-playground' dev",
    "docs": "bun run --filter '@industrieh/docs' dev",
    "example": "bun run --filter '@industrieh/example-basic' start",
    "example:svg": "bun run --filter '@industrieh/example-basic-svg-generation' start",
    "hero": "bun run scripts/hero-image.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun run scripts/relock.ts && oxfmt",
    "release:dry-run": "bun run scripts/publish.ts --dry-run",
    "release:publish": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
