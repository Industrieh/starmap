{
  "name": "@cotontigeh/starmap-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter '@cotontigeh/example-playground' dev",
    "docs": "bun run --filter '@cotontigeh/docs' dev",
    "example": "bun run --filter '@cotontigeh/example-basic' start",
    "example:svg": "bun run --filter '@cotontigeh/example-basic-svg-generation' start",
    "example:react": "bun run --filter '@cotontigeh/example-interactive-react' start"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
