{
  "name": "@cotontigeh/starmap",
  "version": "0.2.0",
  "private": true,
  "description": "A typed star-system model for JS/TS games: describe, validate, query. No dependencies, no rendering.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
