{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "unicorn", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true
  },
  // The shadcn components are vendored, not written here: the CLI wrote them and
  // `shadcn add <name> --diff` updates them against upstream. They trip rules we
  // hold ourselves to — `jsx-a11y/prefer-tag-over-role` in `breadcrumb`,
  // `no-shadow` in `sidebar` — and the only ways to satisfy them are to edit
  // files we do not own or to weaken the rules for everyone. So they are out,
  // exactly as they are out of oxfmt. What *uses* them is still linted.
  "ignorePatterns": ["**/dist", "**/.next", "apps/docs/src/components/ui/**"],
  "overrides": [
    {
      // Tests, tooling, release scripts and examples: a Node context.
      "files": ["**/tests/**/*.ts", "**/*.config.ts", "scripts/**/*.ts", "examples/**/*.ts"],
      "env": {
        "node": true
      }
    },
    {
      // The React example runs in a browser instead, and imports a stylesheet
      // there — a legitimate side-effect import.
      "files": ["examples/playground/src/**"],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // The documentation site. A React app, so three more plugins — they are
      // declared here rather than at the top so that they apply to this app
      // alone: `nextjs` rules mean nothing to the Vite examples, and turning
      // them on globally would only produce noise.
      "files": ["apps/docs/**"],
      "plugins": ["react", "jsx-a11y", "nextjs"],
      "env": {
        "browser": true
      },
      "rules": {
        // `layout.tsx` imports the stylesheet — a legitimate side effect.
        "import/no-unassigned-import": "off",

        // The rule dates from the runtime where JSX compiled to
        // `React.createElement`. With the automatic transform (`jsx:
        // react-jsx`, which is what Next.js uses) the import is injected, and
        // writing it by hand is the mistake.
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
