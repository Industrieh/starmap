{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": true,
  "ignorePatterns": [".agents/**", ".claude/**"],
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": { "singleQuote": false }
    }
  ]
}
